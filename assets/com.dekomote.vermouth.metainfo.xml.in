<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APP_ID@</id>
  <name>Vermouth</name>
  <developer id="com.dekomote">
    <name>@APP_AUTHOR_NAME@</name>
    <email>@APP_AUTHOR_EMAIL@</email>
  </developer>
  <summary>Launch Windows games on KDE</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>@APP_LICENSE@</project_license>
  <description>
    <p>@APP_LONG_DESCRIPTION@</p>
  </description>
  <branding>
    <color type="primary" scheme_preference="light">#b4a0d3</color>
    <color type="primary" scheme_preference="dark">#b4a0d3</color>
  </branding>
  <url type="homepage">@APP_HOMEPAGE@</url>
  <url type="bugtracker">@APP_BUG_ADDRESS@</url>
  <url type="vcs-browser">@APP_HOMEPAGE@</url>
  <launchable type="desktop-id">@APP_ID@.desktop</launchable>
  <screenshots>
    <screenshot type="default">
      <caption>Main game library view</caption>
      <image>https://raw.githubusercontent.com/dekomote/vermouth/v@PROJECT_VERSION@/assets/screen1.png</image>
    </screenshot>
    <screenshot>
      <caption>Game and runtime settings</caption>
      <image>https://raw.githubusercontent.com/dekomote/vermouth/v@PROJECT_VERSION@/assets/screen2.png</image>
    </screenshot>
    <screenshot>
      <caption>Application settings</caption>
      <image>https://raw.githubusercontent.com/dekomote/vermouth/v@PROJECT_VERSION@/assets/screen3.png</image>
    </screenshot>
    <screenshot>
      <caption>Utilities</caption>
      <image>https://raw.githubusercontent.com/dekomote/vermouth/v@PROJECT_VERSION@/assets/screen4.png</image>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.1" />
  <releases>
      <release version="2.0.2" date="2026-08-11">
        <description>
          <p>This release adds the playtime feature, fixes GE Proton download url and adds a check when runtimes are missing.</p>
        </description>
    </release>
    <release version="2.0.1" date="2026-08-05">
        <description>
          <p>This release adds the UZDOOM runtime, the Default Runtime feature, the Sort feature and several minor fixes/QoL addons.</p>
        </description>
    </release>
    <release version="1.9.7" date="2026-07-15">
        <description>
          <p>This release adds the Hide feature - the ability to hide games and toggle visibility. It also changes the deletion workflow.</p>
        </description>
    </release>
    <release version="1.9.6" date="2026-07-08">
        <description>
          <p>This release fixes few UI issues - icon consistencies across desktop environments and button alignments.</p>
        </description>
    </release>
    <release version="1.9.5" date="2026-06-29">
        <description>
          <p>This release fixes the issue where Vermouth creates the cover cache dirs on launch, even when they aren't needed.</p>
        </description>
    </release>
    <release version="1.9.4" date="2026-06-26">
        <description>
          <p>This release improves the hero art view and includes minor fixes.</p>
        </description>
    </release>
    <release version="1.9.3" date="2026-06-23">
        <description>
          <p>This release fixes the winetricks integration.</p>
        </description>
    </release>
    <release version="1.9.2" date="2026-06-13">
        <description>
          <p>This release adds the Gog Store integration.</p>
          <p>Browse, download and play your Gog games directly from Vermouth. Additionally,
          32 bit support has been added to the flatpak for 32 bit games.</p>
        </description>
    </release>
    <release version="1.9.1" date="2026-06-07">
        <description>
          <p>This release is focused on UI/UX improvements, code cleanup and optimizations.</p>
          <ul>
            <li>UI tweaks to make it even more in line with KDE apps/Kirigami</li>
            <li>Settings, About and Welcome are now full pages instead of pop-up dialogs</li>
            <li>Reworked pinnable, resizable sidebar</li>
            <li>New "Alternative grid background" appearance option</li>
            <li>Deleting an app and its prefix now shows the path and asks you to type DELETE to confirm</li>
            <li>Steam/GOG import: add Select All / Deselect All buttons</li>
            <li>The status bar correctly shows the runner and executable path</li>
            <li>Prevent Sleep now works on non-Flatpak installs</li>
            <li>Re-downloading cover art now correctly replaces the existing image</li>
          </ul>
        </description>
    </release>
  </releases>
</component>
